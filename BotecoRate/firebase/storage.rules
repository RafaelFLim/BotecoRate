rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploads belong to a verified account; publication permissions are
    // independently enforced by Realtime Database for bars and menu items.
    match /catalog/{uid}/{file} {
      allow read: if request.auth != null && request.auth.token.email_verified == true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg'
        && file.matches('[a-f0-9]{64}[.]jpg');
      allow update, delete: if false;
    }
  }
}
