# Configuração CLIENTE do seu projeto. Copie para .env.local (não versionado).
# Firebase Console > Configurações do projeto > aplicativo Web.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=botecorate
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Opcional: bucket do Firebase Storage para sincronizar fotos novas.
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
