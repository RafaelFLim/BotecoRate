# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.tools/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Claude Code skills instaladas localmente (não versionar)
.claude/skills/

# Contexto local para assistentes de IA (não versionar)
CLAUDE.md

# Ferramentas administrativas Python (sem credenciais no repositório)
__pycache__/
*.pyc
server/.venv/

# Emuladores Firebase (logs e estado local)
.firebase/
firebase-debug.log*
database-debug.log*
ui-debug.log*
