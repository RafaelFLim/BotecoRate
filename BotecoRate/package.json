{
  "name": "botecorate",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "expo": "^58.0.19",
    "expo-camera": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-file-system": "~58.0.11",
    "expo-image-manipulator": "~58.0.15",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.19",
    "expo-media-library": "~58.0.12",
    "expo-splash-screen": "~58.0.11",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0"
  },
  "scripts": {
    "postinstall": "node scripts/fix-sqlite-inspector.cjs && node scripts/fix-expo-go-icon.cjs",
    "start": "expo start",
    "start:tunnel": "node scripts/start-tunnel.cjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test tests/*.test.mjs",
    "test:direct": "npx firebase-tools@14.17.0 emulators:exec --only database --project demo-botecorate \"node --test tests/ownership.test.mjs tests/admin.test.mjs tests/directSync.test.mjs tests/firebaseRules.test.mjs\"",
    "check:firebase": "node scripts/check-firebase.cjs",
    "check:secrets": "node scripts/check-secrets.cjs",
    "test:server": "node scripts/test-server.cjs",
    "test:sync:emulator": "npx firebase-tools@14.17.0 emulators:exec --only database --project demo-botecorate \"node scripts/test-server.cjs --emulator\"",
    "test:rules": "npx firebase-tools@14.17.0 emulators:exec --only database --project demo-botecorate \"node --test tests/firebaseRules.test.mjs\""
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "^5.0.2"
  }
}
